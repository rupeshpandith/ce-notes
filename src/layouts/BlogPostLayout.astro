---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import '../styles/article.css';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, author, categories, tags, heroImage, heroImageAlt } = post.data;

// Build sidebar data
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryCounts: Record<string, number> = {};
const allTags = new Set<string>();
for (const p of allPosts) {
  for (const c of p.data.categories) categoryCounts[c] = (categoryCounts[c] || 0) + 1;
  for (const t of p.data.tags) allTags.add(t);
}

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const isoDate = pubDate.toISOString();

// Estimate reading time
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const urlSlug = post.data.slug ?? post.slug;
const canonicalURL = new URL(
  `/posts/${urlSlug}/`,
  import.meta.env.SITE || 'https://yourusername.github.io'
).toString();
---
<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  heroImage={heroImage}
  heroImageAlt={heroImageAlt}
  type="article"
  pubDate={pubDate}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>

  <div class="page-main">
    <div class="layout-two-col">
      <!-- Main Article -->
      <div class="layout-two-col__main">
        <article itemscope itemtype="https://schema.org/Article">
          <header class="article-header">
            {heroImage && (
              <img
                src={heroImage}
                alt={heroImageAlt || title}
                class="article-hero"
                loading="eager"
                width="1200"
                height="630"
                itemprop="image"
              />
            )}

            <!-- Category -->
            <div style="margin-bottom: 0.75rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
              {categories.map((cat) => (
                <a
                  href={`/categories/${cat.toLowerCase().replace(/\s+/g, '-')}/`}
                  class="category-badge"
                >
                  {cat}
                </a>
              ))}
            </div>

            <h1 class="article-title" itemprop="headline">{title}</h1>
            <p class="article-description">{description}</p>

            <!-- Meta row with refined micro-icons -->
            <div class="article-meta" aria-label="Article metadata">
              <span class="article-meta__item" itemprop="author" itemscope itemtype="https://schema.org/Person">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span itemprop="name">{author}</span>
              </span>
              <span class="article-meta__sep" aria-hidden="true">·</span>
              <time class="article-meta__item" datetime={isoDate} itemprop="datePublished">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                {formattedDate}
              </time>
              <span class="article-meta__sep" aria-hidden="true">·</span>
              <span class="article-meta__item">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                {readingTime} min read
              </span>
              <span class="article-meta__sep" aria-hidden="true">·</span>
              <span class="article-meta__item">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                {wordCount.toLocaleString()} words
              </span>
            </div>
          </header>

          <!-- Inline TOC for mobile -->
          {headings.filter(h => h.depth <= 3).length > 0 && (
            <details class="inline-toc">
              <summary>Table of Contents</summary>
              <ol class="inline-toc__list">
                {headings.filter(h => h.depth <= 3).map((h) => (
                  <li class={h.depth === 3 ? 'h3' : ''}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )}

          <!-- Article Body -->
          <div class="prose" itemprop="articleBody">
            <slot />
          </div>

          <!-- Article Tags -->
          <footer class="article-tags">
            <p class="article-tags__label">Tags</p>
            <div class="tag-list" aria-label="Article tags">
              {tags.map((tag) => (
                <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="tag">#{tag}</a>
              ))}
            </div>
          </footer>
        </article>
      </div>

      <!-- Sidebar -->
      <div class="layout-two-col__sidebar">
        <Sidebar
          posts={allPosts}
          recentPosts={allPosts}
          categories={categoryCounts}
          tags={Array.from(allTags)}
          showToc={true}
          headings={headings}
        />
      </div>
    </div>
  </div>

  <!-- Back to Top Floating Button -->
  <button id="back-to-top" class="back-to-top" aria-label="Scroll to top" title="Scroll back to top">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
  </button>
</BaseLayout>

<script>
  // Reading Progress Bar
  function setupReadingProgress() {
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector('article');
    if (!progressBar || !article) return;

    function updateProgress() {
      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = rect.height;
      const windowHeight = window.innerHeight;
      const scrollPos = window.scrollY;

      if (scrollPos < articleTop) {
        progressBar.style.width = '0%';
      } else if (scrollPos > articleTop + articleHeight - windowHeight) {
        progressBar.style.width = '100%';
      } else {
        const progress = ((scrollPos - articleTop) / (articleHeight - windowHeight)) * 100;
        progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  // Back to Top Button
  function setupBackToTop() {
    const backToTopBtn = document.getElementById('back-to-top');
    if (!backToTopBtn) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        backToTopBtn.classList.add('visible');
      } else {
        backToTopBtn.classList.remove('visible');
      }
    }, { passive: true });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Interactive Code Copy Button
  function setupCodeCopy() {
    const codeBlocks = document.querySelectorAll<HTMLElement>('.prose pre');
    codeBlocks.forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;

      const button = document.createElement('button');
      button.className = 'code-copy-btn';
      button.type = 'button';
      button.setAttribute('aria-label', 'Copy code snippet');
      button.setAttribute('title', 'Copy code');
      button.innerHTML = `
        <svg class="copy-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span class="copy-label">Copy</span>
      `;

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.innerText : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          button.classList.add('copied');
          button.innerHTML = `
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="copy-label">Copied!</span>
          `;
          setTimeout(() => {
            button.classList.remove('copied');
            button.innerHTML = `
              <svg class="copy-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-label">Copy</span>
            `;
          }, 2000);
        } catch (_) {}
      });

      pre.appendChild(button);
    });
  }

  setupReadingProgress();
  setupBackToTop();
  setupCodeCopy();

  document.addEventListener('astro:after-swap', () => {
    setupReadingProgress();
    setupBackToTop();
    setupCodeCopy();
  });
</script>


